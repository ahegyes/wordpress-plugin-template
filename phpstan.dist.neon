includes:
    - vendor/ahegyes/wordpress-configs/php/quality-assurance/phpstan.dist.neon

parameters:
    paths:
        - dws-plugin-template.php
        - functions.php
        - uninstall.php
        - src
        - config
        - tests
    # The example WooCommerce settings page subclasses \WC_Settings_Page; its symbol comes from the stub
    # catalog (WooCommerce is not installed here). scanFiles, not bootstrapFiles: requiring it would fatal.
    scanFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    excludePaths:
        analyseAndScan:
            - dependencies/*
            - vendor/*
            - node_modules/*
            - tests/bootstrap.php
            # Guarded mock-WordPress shims; scanning them would shadow the wordpress-stubs signatures.
            - tests/Unit/bootstrap-wp-stubs.php
